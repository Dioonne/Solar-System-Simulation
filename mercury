import math

import matplotlib.pyplot as plt
import numpy as np
import taichi as ti


ti.init(arch=ti.cpu)

# Physical constants (SI units).
G = 6.67430e-11
M_SUN = 1.98847e30
M_MERCURY = 3.3011e23
R_SUN = 6.957e8
R_MERCURY = 2.4397e6
A_MERCURY = 5.7909e10
E_MERCURY = 0.2056
T_MERCURY_DAYS = 87.96

# Simulation parameters.
FIX_SUN = False
DT = 300.0
STEPS_PER_FRAME = 24
WIDTH, HEIGHT = 800, 800
SCALE_VIS = 1.5e11
N = 2
SUN_IDX = 0
MERCURY_IDX = 1
MAX_TRAIL_STEPS = 26000

mass = ti.field(dtype=ti.f64, shape=N)
pos = ti.Vector.field(3, dtype=ti.f64, shape=N)
vel = ti.Vector.field(3, dtype=ti.f64, shape=N)
acc = ti.Vector.field(3, dtype=ti.f64, shape=N)
trail_pos = ti.Vector.field(3, dtype=ti.f32, shape=MAX_TRAIL_STEPS)
trail_head = ti.field(dtype=ti.i32, shape=())
trail_count = ti.field(dtype=ti.i32, shape=())
render_trail_pos = ti.Vector.field(3, dtype=ti.f32, shape=MAX_TRAIL_STEPS)
render_trail_indices = ti.field(dtype=ti.i32, shape=(MAX_TRAIL_STEPS - 1) * 2)
render_pos = ti.Vector.field(3, dtype=ti.f32, shape=N)
planet_colors = ti.Vector.field(3, dtype=ti.f32, shape=N)

def init_conditions():
    """Calculate and set the initial positions and velocities."""
    perihelion = A_MERCURY * (1.0 - E_MERCURY)
    perihelion_speed = math.sqrt(
        G * M_SUN * ((2.0 / perihelion) - (1.0 / A_MERCURY))
    )

    mass[SUN_IDX] = M_SUN
    mass[MERCURY_IDX] = M_MERCURY
    pos[SUN_IDX] = [0.0, 0.0, 0.0]
    vel[SUN_IDX] = [0.0, 0.0, 0.0]
    pos[MERCURY_IDX] = [perihelion, 0.0, 0.0]
    vel[MERCURY_IDX] = [0.0, perihelion_speed, 0.0]
    planet_colors[SUN_IDX] = [1.0, 0.8, 0.0]
    planet_colors[MERCURY_IDX] = [0.6, 0.6, 0.6]

    if not FIX_SUN:
        vel[SUN_IDX] = [0.0, -(M_MERCURY / M_SUN) * perihelion_speed, 0.0]
        barycenter = (
            M_SUN * pos[SUN_IDX].to_numpy()
            + M_MERCURY * pos[MERCURY_IDX].to_numpy()
        ) / (M_SUN + M_MERCURY)
        pos[SUN_IDX] = pos[SUN_IDX].to_numpy() - barycenter
        pos[MERCURY_IDX] = pos[MERCURY_IDX].to_numpy() - barycenter

    trail_head[None] = 0
    trail_count[None] = 0
    init_trail_indices()


@ti.kernel
def init_trail_indices():
    for i in range(MAX_TRAIL_STEPS - 1):
        render_trail_indices[i * 2] = i
        render_trail_indices[i * 2 + 1] = i + 1

@ti.kernel
def compute_acceleration():
    for i in range(N):
        acc[i] = ti.Vector([0.0, 0.0, 0.0])
        for j in range(N):
            if i != j:
                displacement = pos[j] - pos[i]
                distance_squared = displacement.dot(displacement)
                distance = ti.sqrt(distance_squared)
                acc[i] += G * mass[j] * displacement / (distance_squared * distance)


@ti.kernel
def integrate(dt: ti.types.f64, fix_sun: ti.types.i32):
    for i in range(N):
        if fix_sun == 1 and i == SUN_IDX:
            continue
        vel[i] += 0.5 * dt * acc[i]
        pos[i] += dt * vel[i]


@ti.kernel
def complete_velocity(dt: ti.types.f64, fix_sun: ti.types.i32):
    for i in range(N):
        if fix_sun == 1 and i == SUN_IDX:
            continue
        vel[i] += 0.5 * dt * acc[i]


@ti.kernel
def record_trail(idx: ti.types.i32):
    head = trail_head[None]
    trail_pos[head] = ti.cast(pos[idx] / SCALE_VIS, ti.f32)
    trail_head[None] = (head + 1) % MAX_TRAIL_STEPS
    if trail_count[None] < MAX_TRAIL_STEPS:
        trail_count[None] += 1

@ti.kernel
def update_render_trail():
    count = trail_count[None]
    head = trail_head[None]
    start_idx = 0
    if count == MAX_TRAIL_STEPS:
        start_idx = head

    for i in range(MAX_TRAIL_STEPS):
        if i < count:
            render_trail_pos[i] = trail_pos[(start_idx + i) % MAX_TRAIL_STEPS]
        else:
            if count > 0:
                render_trail_pos[i] = trail_pos[(start_idx + count - 1) % MAX_TRAIL_STEPS]
            else:
                render_trail_pos[i] = ti.Vector([0.0, 0.0, 0.0])

@ti.kernel
def update_render_pos():
    for i in range(N):
        render_pos[i] = ti.cast(pos[i] / SCALE_VIS, ti.f32)

@ti.kernel
def calculate_energy() -> ti.types.f64:
    total_energy = ti.cast(0.0, ti.f64)
    for i in range(N):
        total_energy += 0.5 * mass[i] * vel[i].dot(vel[i])
    for i in range(N):
        for j in range(i + 1, N):
            displacement = pos[j] - pos[i]
            distance = ti.sqrt(displacement.dot(displacement))
            total_energy -= G * mass[i] * mass[j] / distance
    return total_energy


def main():
    init_conditions()
    compute_acceleration()
    record_trail(MERCURY_IDX)

    sim_time = 0.0
    frame_count = 0
    initial_energy = calculate_energy()
    history_t = []
    history_energy_error = []
    history_mercury_x = []
    history_mercury_y = []

    window = ti.ui.Window("3D Solar System", (WIDTH, HEIGHT))
    canvas = window.get_canvas()
    scene = window.get_scene()
    camera = ti.ui.Camera()
    
    # Add these three lines to control our orbit math!
    cam_radius = 2.5
    cam_yaw = 0.0
    cam_pitch = 0.3
    while window.running:
        for _ in range(STEPS_PER_FRAME):
            integrate(DT, int(FIX_SUN))
            compute_acceleration()
            complete_velocity(DT, int(FIX_SUN))
            sim_time += DT
            record_trail(MERCURY_IDX)
        update_render_pos()
                # 1. Update positions and allow user to rotate camera (Hold Right Click)
        update_render_pos()
        window.get_events() 
        
        # 2. Zoom in and out with W and S
        if window.is_pressed('w') and cam_radius > 0.2:
            cam_radius -= 0.05
        if window.is_pressed('s'):
            cam_radius += 0.05
            
        # 3. Orbit with LEFT CLICK (LMB)
        if window.is_pressed(ti.ui.LMB):
            mouse_x, mouse_y = window.get_cursor_pos()
            cam_yaw = mouse_x * 7.0 
            cam_pitch = max(0.01, mouse_y * 3.14)
            
        # 4. Perfectly calculate the camera angle for an X-Y orbit
        camera.position(
            cam_radius * math.sin(cam_yaw) * math.sin(cam_pitch),
            cam_radius * math.cos(cam_yaw) * math.sin(cam_pitch),
            cam_radius * math.cos(cam_pitch)
        )
        camera.lookat(0.0, 0.0, 0.0)
        scene.set_camera(camera)
        # 2. Add Real-time Lighting 
        positions = pos.to_numpy()
        sun_p = positions[SUN_IDX] / SCALE_VIS
        scene.ambient_light((0.05, 0.05, 0.05))  
        scene.point_light(pos=(0.0, 0.0, 0.0), color=(1.5, 1.5, 1.5)) # Lights up Mercury
        scene.point_light(pos=(1.0, 1.0, 1.0), color=(1.0, 1.0, 1.0)) # Shines directly onto the Sun
        # 3. Draw Planets and Trail
               # 3. Draw Planets and Trail
        scene.particles(trail_pos, radius=0.0015, color=(0.8, 0.8, 0.8)) # Overlapping particles form a solid path
        
        # Draw Sun larger (radius 0.08) and Mercury smaller (radius 0.02)
        scene.particles(render_pos, radius=0.04, index_offset=SUN_IDX, index_count=1, color=(1.0, 0.9, 0.0))
        scene.particles(render_pos, radius=0.02, index_offset=MERCURY_IDX, index_count=1, color=(0.6, 0.6, 0.6))
        canvas.scene(scene)

        # 4. Draw UI Panel
        distance = np.linalg.norm(positions[SUN_IDX] - positions[MERCURY_IDX])
        mercury_speed = np.linalg.norm(vel[MERCURY_IDX].to_numpy())
        
        ui = window.get_gui()
        ui.begin("Simulation Info", 0.02, 0.02, 0.35, 0.2)
        ui.text(f"Time: {sim_time / 86400.0:.1f} days")
        ui.text(f"Distance: {distance / 1e9:.2f} Gm")
        ui.text(f"Velocity: {mercury_speed / 1000.0:.2f} km/s")
        ui.text("Right-Click & Drag to rotate camera")
        ui.end()

        window.show()
        if frame_count % 10 == 0:
            current_energy = calculate_energy()
            energy_error = abs((current_energy - initial_energy) / initial_energy)
            time_days = sim_time / 86400.0
            mercury_position = positions[MERCURY_IDX]
            history_t.append(time_days)
            history_energy_error.append(energy_error)
            history_mercury_x.append(mercury_position[0])
            history_mercury_y.append(mercury_position[1])
            print(
                f"Time: {time_days:6.2f} days | "
                f"Dist: {distance / 1e9:6.2f} Gm | "
                f"Vel: {mercury_speed / 1000.0:5.2f} km/s | "
                f"E_err: {energy_error:.2e}"
            )

            if len(history_mercury_y) > 1 and 87.9 < time_days < 88.1:
                if mercury_position[1] > 0 and history_mercury_y[-2] <= 0:
                    print("\n*** MERCURY HAS COMPLETED ONE ORBIT! ***\n")

        frame_count += 1

    print("Simulation ended. Plotting validation graphs...")
    figure, (axis_trajectory, axis_energy) = plt.subplots(1, 2, figsize=(12, 5))
    axis_trajectory.plot(
        history_mercury_x,
        history_mercury_y,
        label="Mercury Trajectory",
        color="gray",
    )
    axis_trajectory.plot([0], [0], "yo", markersize=10, label="Sun (Approx Origin)")
    axis_trajectory.set_xlabel("X Position (m)")
    axis_trajectory.set_ylabel("Y Position (m)")
    axis_trajectory.set_title("Simulated Orbital Trajectory")
    axis_trajectory.set_aspect("equal", "box")
    axis_trajectory.legend(frameon=False)
    axis_trajectory.grid(True)

    axis_energy.plot(history_t, history_energy_error, color="red")
    axis_energy.set_xlabel("Time (days)")
    axis_energy.set_ylabel("Relative Energy Error |(E-E0)/E0|")
    axis_energy.set_title(f"Energy Conservation (dt={DT}s)")
    axis_energy.set_yscale("log")
    axis_energy.grid(True)
    figure.tight_layout()
    plt.show()


if __name__ == "__main__":
    main()
